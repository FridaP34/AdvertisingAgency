# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only for the one-time import script (tools/import-works.mjs).
# Server-side secret — never add NEXT_PUBLIC_ in front of it.
SUPABASE_SERVICE_ROLE_KEY=

# ── Contact form (Resend) ───────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ── Public site ─────────────────────────────────────────────────────────────
# Canonical address, used for metadata and robots.txt.
# Production (Vercel): https://plavinsky.co.il
# Local: http://localhost:3000
# No trailing slash — it is used for the canonical tag, the share preview,
# robots.txt and the sitemap.
NEXT_PUBLIC_SITE_URL=https://plavinsky.co.il
